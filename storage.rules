rules_version = '2';

// SynthInnoTech — Cloud Storage security rules
// Deploy with:  firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isImageUnder(mb) {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < mb * 1024 * 1024;
    }

    // Profile photos: anyone signed-in can view; you can only write your own.
    match /avatars/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid && isImageUnder(5);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Project attachments: any signed-in user may read/upload (≤ 15 MB).
    match /projects/{projectId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.size < 15 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
